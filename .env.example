# Export these (or load them with your shell) before running main.py
ORION_URL=https://example.com/product-page
ORION_TARGET_PRICE=35000
ORION_INTERVAL_MINUTES=60
# CSS class of the element that holds the price (default fits one specific store)
ORION_PRICE_CLASS=product-list__price
# Create a bot with @BotFather; get your chat id from the getUpdates API
TELEGRAM_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id
# v2: put several products in watchlist.txt instead (see watchlist.example.txt);
# ORION_URL / ORION_TARGET_PRICE are only used when watchlist.txt does not exist.
